# ==============================================================================
# SentinelScan Environment Configuration Template
# Copy this file to .env before starting the platform
# ==============================================================================

# Application Meta
APP_NAME=SentinelScan
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Network & Host Binding
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: Local zero-dependency SQLite
DATABASE_URL=sqlite:///./sentinelscan.db
# Alternative: PostgreSQL for scalable production
# DATABASE_URL=postgresql://sentinel_user:secure_password@localhost:5432/sentinelscan

# Security & CORS Settings (Must be valid JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://localhost:80", "http://127.0.0.1:5173"]

# Scanner Concurrency & Execution Limits
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=30
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=2097152

# SSRF Protection Policy Settings (Strict mode blocks all non-public networks)
ALLOW_INTERNAL_NETWORKS=false
